{
  "name": "web-aimanganell",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web de AI Manganell · Consultoría IA & Ciberseguridad",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=main.js --target=es2020 && esbuild src/config.ts --outfile=config.js --target=es2020",
