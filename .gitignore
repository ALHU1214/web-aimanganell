# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
*.swp
*.swo

# Logs
*.log

# Entorno / secretos, por si se añaden más adelante
.env
.env.local

# Exports de workflows de n8n (exponen estructura interna y IDs
# de hojas de Google). La regla es global, no solo de la raíz: antes
# era /*.json y un export guardado en blog/ o scripts/ habría entrado
# al repo sin avisar.
*.json
# Excepciones: si algún día hay que versionar un .json, se añade aquí
# con ! delante. Estas dos van por adelantado porque que se ignoraran
# en silencio rompería el repo para cualquiera que lo clonara.
!package.json
!package-lock.json
!tsconfig.json
node_modules/

# Estado interno del proyecto (arquitectura, IDs de Supabase,
# pendientes de seguridad) — solo debe existir en local
/ESTADO-PROYECTO.md

# Caché local del CLI de Supabase (project-ref, org id, URL del
# pooler...) — se regenera con `supabase link`, no es código del
# proyecto y no debe commitearse
/supabase/.temp/

# Piezas de marca para redes: pesan MB y no las sirve la web.
# Viven aqui por comodidad, pero no deben publicarse.
assets/BANNER*.png

# Logos que se usan fuera de la web (redes, documentos) pero que la web
# no necesita: se quedan en local y no se publican. Los que usa la web
# (horizontal-x, simbolo-a.webp, nombre-mascara.webp...) no van aqui.
assets/logos/vertical-x.png
assets/logos/vertical-lema-x.png
assets/logos/vertical-lema-compacto-x.png
assets/logos/monograma-negro-x.png
assets/logos/simbolo-a.png
assets/logos/logo fondo oscuro con nombre.png
assets/logos/perfil logo.png
assets/logos/upscalemedia-transformed.jpeg
